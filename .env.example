# Copy to .env — never commit .env
# Optional: Google Places API (better business coverage)
GOOGLE_PLACES_API_KEY=

# Gmail sending (GitHub Secrets in Actions, .env locally)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Your signature for outreach emails
SENDER_NAME=Your Name
SENDER_BUSINESS=Your Web Studio
SENDER_EMAIL=you@example.com
SENDER_WEBSITE=https://your-site.com
SENDER_PHONE=
